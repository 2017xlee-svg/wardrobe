rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Garment photos: read by anyone, write allowed for valid images up to 25MB
    match /garments/{clothesId}/photos/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Report photos: read by anyone, write allowed for valid images up to 25MB
    match /reports/{reportId}/photos/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Large text payloads / contracts / markdown documentation: read by anyone, up to 10MB
    match /payloads/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
      allow delete: if true;
    }

    // General attachments: documents, PDFs, etc.
    match /attachments/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
      allow delete: if true;
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }
  }
}
